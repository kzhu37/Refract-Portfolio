{
  "name": "refract",
  "version": "1.0.0",
  "description": "Refract: experimental gaze-aware adaptive display prototype",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:web-demo": "vite --config vite.web-demo.config.ts",
    "generate:icons": "electron scripts/generate-icons.cjs",
    "build": "electron-vite build",
    "build:web-demo": "vite build --config vite.web-demo.config.ts",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node .test-dist/tests/math-tests.js",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:demo",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:demo": "tsc --noEmit -p tsconfig.demo.json --composite false"
  },
  "dependencies": {
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@tensorflow/tfjs": "^4.22.0",
    "electron-store": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "electron": "^32.0.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
